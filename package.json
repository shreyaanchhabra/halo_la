{
  "name": "halo-la",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sim": "evenhub-simulator http://localhost:5175",
    "qr": "evenhub qr --clear && evenhub qr --http --ip $(ipconfig getifaddr en0) --port 5175",
    "pack": "npm run build && evenhub pack app.json dist",
    "portal": "vite portal",
    "test": "node --test \"portal/server/**/*.test.ts\" \"portal/src/**/*.test.ts\" \"shared/**/*.test.ts\" \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p portal && tsc --noEmit -p portal/server"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^26.6.5",
    "typescript": "~5.9",
    "unpdf": "^1.9.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@photon-ai/api": "^0.5.0",
    "@sentry/browser": "^11.8.0",
    "@sentry/node": "^11.8.0",
    "browser-use-sdk": "^3.12.1",
    "chrono-node": "^2.10.3"
  }
}
